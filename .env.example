# Copia este archivo a .env.local. No escribas secretos en el repositorio.
#
# Esquema único del proyecto. El código SMTP lee estos nombres (no EMAIL_* ni GMAIL_*).
# El export estático de cPanel no ejecuta el correo: esas variables solo aplican
# cuando src/server/email/contact-mailer.ts corre en un servidor Node (Vercel).
#
# NEXT_PUBLIC_* se incrusta en el JavaScript del navegador. No pongas secretos ahí.

# Correo Microsoft 365. Host por defecto smtp.office365.com, puerto 587, STARTTLS.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# YouTube Data API de /live. Vacío en el sitio estático publicado.
NEXT_PUBLIC_YOUTUBE_API_KEY=
NEXT_PUBLIC_ENABLE_REAL_TIME_DATA=false
